<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.irmaosmiau</groupId>
    <artifactId>AventuraIrmaosMiau</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bytecode Java 23; compila e roda no JDK 25 (Temurin) do ambiente atual. -->
        <maven.compiler.release>23</maven.compiler.release>
        <!-- Classe principal oficial: menu -> selecao -> jogo. -->
        <exec.mainClass>com.irmaosmiau.main.Main</exec.mainClass>
        <junit.version>5.10.5</junit.version>
        <!-- Entrega 5D: leitura de gamepad (GLFW). BSD-3-Clause, ver docs/CONTROLES.md. -->
        <lwjgl.version>3.4.3</lwjgl.version>
        <!-- Nativos incluidos no JAR: somente Windows x64 (o jogo abre sem gamepad nos outros). -->
        <lwjgl.natives>natives-windows</lwjgl.natives>
    </properties>

    <dependencies>
        <!--
          Entrega 5D: gamepad. So a classe dispositivos.glfw.ProvedorGamepadGlfw usa
          LWJGL, carregada por reflexao: sem estes jars/DLLs o jogo segue com teclado.
        -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <version>${lwjgl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <version>${lwjgl.version}</version>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <!-- Somente para testes; nao entra no JAR do jogo. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- 5D: LWJGL usa JNI; sem aviso de acesso nativo nos testes. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <!-- Testes nao abrem janelas Swing. -->
                        <java.awt.headless>true</java.awt.headless>
                        <!-- 5D: DLLs do GLFW extraidas em target/, nunca na pasta pessoal. -->
                        <org.lwjgl.system.SharedLibraryExtractPath>${project.build.directory}/lwjgl-nativos</org.lwjgl.system.SharedLibraryExtractPath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- 5D: testes do JAR final (*IT) em "mvn verify", depois do package. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.awt.headless>true</java.awt.headless>
                        <jar.jogo>${project.build.directory}/${project.build.finalName}.jar</jar.jogo>
                        <dir.nativos>${project.build.directory}/lwjgl-nativos-it</dir.nativos>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!--
              5D: JAR unico com o LWJGL dentro (java -jar continua bastando).
              Multi-Release: o LWJGL tem classes especificas por versao do Java.
              Enable-Native-Access: sem aviso do JDK ao carregar as DLLs do GLFW.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/INDEX.LIST</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
